{
  "dashboard": {
    "id": null,
    "uid": "quiz-app-overview",
    "title": "Quiz-O-Meter Application Dashboard",
    "tags": ["quiz", "application"],
    "timezone": "browser",
    "panels": [
      {
        "id": 1,
        "title": "Backend Pod Status",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(kube_pod_status_phase{namespace=~\"quiz-dev|quiz-prod\", pod=~\".*backend.*\", phase=\"Running\"})",
            "legendFormat": "Running Pods"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 0, "y": 0}
      },
      {
        "id": 2,
        "title": "Frontend Pod Status",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(kube_pod_status_phase{namespace=~\"quiz-dev|quiz-prod\", pod=~\".*frontend.*\", phase=\"Running\"})",
            "legendFormat": "Running Pods"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 6, "y": 0}
      },
      {
        "id": 3,
        "title": "Redis Status",
        "type": "stat",
        "targets": [
          {
            "expr": "sum(kube_pod_status_phase{namespace=~\"quiz-dev|quiz-prod\", pod=~\".*redis.*\", phase=\"Running\"})",
            "legendFormat": "Running"
          }
        ],
        "gridPos": {"h": 4, "w": 6, "x": 12, "y": 0}
      },
      {
        "id": 4,
        "title": "CPU Usage by Pod",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=~\"quiz-dev|quiz-prod\", pod=~\".*backend.*\"}[5m])) by (pod)",
            "legendFormat": "{{pod}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 0, "y": 4}
      },
      {
        "id": 5,
        "title": "Memory Usage by Pod",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(container_memory_working_set_bytes{namespace=~\"quiz-dev|quiz-prod\"}) by (pod)",
            "legendFormat": "{{pod}}"
          }
        ],
        "gridPos": {"h": 8, "w": 12, "x": 12, "y": 4}
      },
      {
        "id": 6,
        "title": "Pod Restarts",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(kube_pod_container_status_restarts_total{namespace=~\"quiz-dev|quiz-prod\"}) by (pod)",
            "legendFormat": "{{pod}}"
          }
        ],
        "gridPos": {"h": 6, "w": 12, "x": 0, "y": 12}
      },
      {
        "id": 7,
        "title": "Network Traffic",
        "type": "graph",
        "targets": [
          {
            "expr": "sum(rate(container_network_receive_bytes_total{namespace=~\"quiz-dev|quiz-prod\"}[5m])) by (pod)",
            "legendFormat": "Receive {{pod}}"
          },
          {
            "expr": "sum(rate(container_network_transmit_bytes_total{namespace=~\"quiz-dev|quiz-prod\"}[5m])) by (pod)",
            "legendFormat": "Transmit {{pod}}"
          }
        ],
        "gridPos": {"h": 6, "w": 12, "x": 12, "y": 12}
      }
    ],
    "refresh": "30s",
    "schemaVersion": 16,
    "version": 0
  }
}
